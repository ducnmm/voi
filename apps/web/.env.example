# Server-side proxy target: API origin without /v1
VOI_API_ORIGIN="http://127.0.0.1:43187"
# Optional direct browser API base; leave unset to use the same-origin proxy.
# NEXT_PUBLIC_API_BASE_URL="https://api.example.com/v1"
# Google Web application OAuth client (also set GOOGLE_WEB_CLIENT_ID on the API)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-web-client.apps.googleusercontent.com"

# Sign in with Apple: Services ID and registered HTTPS return URL
# NEXT_PUBLIC_APPLE_CLIENT_ID="com.example.voi.web"
# NEXT_PUBLIC_APPLE_REDIRECT_URI="https://voi.example.com/"
# Optional raster tile provider. Keep the provider's required attribution.
# Development defaults to OSM Deutschland; production defaults to standard OSM.
# NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
