{
  "name": "voi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @voi/api dev",
    "dev:api": "pnpm --filter @voi/api dev",
    "dev:web": "pnpm --filter @voi/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e:ios": "bash apps/ios/scripts/run-e2e.sh",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @voi/api db:generate",
    "db:migrate": "pnpm --filter @voi/api db:migrate",
    "db:deploy": "pnpm --filter @voi/api db:deploy",
    "db:seed": "pnpm --filter @voi/api db:seed",
    "db:studio": "pnpm --filter @voi/api db:studio"
  }
}
